# ===========================================================================
# Work Assistant AI — configuration
#
#   cp .env.example .env     then edit. .env is gitignored; keep it that way.
# ===========================================================================


# ===========================================================================
# 1. WHICH MODEL  —  this is the single variable swap
# ===========================================================================
#   cloud  ->  CLOUD_* is the primary, LOCAL_* becomes the fallback
#   local  ->  LOCAL_* is the primary, CLOUD_* becomes the fallback
#
# Fill in both blocks and you get automatic failover: if the primary times out
# or errors, the other one answers. Fill in only one and you simply have no
# fallback. Switching is a one-word edit on the line below.
LLM_PROVIDER=cloud


# --- CLOUD model -----------------------------------------------------------
# Any OpenAI-compatible endpoint. Examples:
#   OpenAI      https://api.openai.com/v1              gpt-4o-mini
#   NVIDIA NIM  https://integrate.api.nvidia.com/v1    meta/llama-3.3-70b-instruct
#   Groq        https://api.groq.com/openai/v1         llama-3.3-70b-versatile
#   Together    https://api.together.xyz/v1            Qwen/Qwen2.5-72B-Instruct-Turbo
#   OpenRouter  https://openrouter.ai/api/v1           anthropic/claude-3.5-sonnet
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=sk-REPLACE_ME
CLOUD_MODEL=gpt-4o-mini
CLOUD_LABEL=
#CLOUD_TEMPERATURE=0.2
# Provider-specific extras, as JSON. Leave blank unless you need it.
#CLOUD_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}


# --- LOCAL model -----------------------------------------------------------
# Ollama, LM Studio, vLLM, llama.cpp — anything exposing an OpenAI-compatible
# /v1 endpoint. Note the /v1 suffix; Ollama's default port is 11434.
# The API key is ignored by most local servers but must not be empty.
#
# IMPORTANT: pick a model that supports TOOL CALLING, or the assistant will
# chat happily but never actually run a query or a script. Known good:
# qwen2.5, qwen3, llama3.1/3.3, mistral-nemo, firefunction-v2.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=local
LOCAL_MODEL=qwen2.5:14b
LOCAL_LABEL=
#LOCAL_TEMPERATURE=0.2
#LOCAL_EXTRA_BODY=


# --- Model timeouts --------------------------------------------------------
# LLM_REQUEST_TIMEOUT  HTTP read timeout, seconds.
# LLM_HARD_TIMEOUT     absolute cap per backend. Keep it ABOVE the above. This
#                      is what stops a wedged request hanging the UI forever.
# LLM_MAX_RETRIES      leave at 0. The OpenAI SDK retries twice by default,
#                      which turns a 60s timeout into 3 minutes of silence.
# LLM_COOLDOWN         after ALL backends fail, fail new messages instantly for
#                      this many seconds instead of re-walking every timeout.
LLM_REQUEST_TIMEOUT=60
LLM_HARD_TIMEOUT=75
LLM_MAX_RETRIES=0
LLM_COOLDOWN=120


# ===========================================================================
# 2. DATABASE
# ===========================================================================
# DB_KIND is either 'postgres' or 'synapse'.
#   postgres  -> PostgreSQL, Redshift, TimescaleDB, anything speaking pg
#   synapse   -> Azure Synapse / Azure SQL / SQL Server (needs an ODBC driver,
#                see requirements.txt)
#
# Leave DB_HOST empty and the SQL tools are simply not offered.
DB_KIND=postgres
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_LABEL=main
DB_DESCRIPTION=
# Synapse / SQL Server only:
#DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# READ-ONLY BY DEFAULT. Anything that modifies data is rejected before it
# reaches the server, and Postgres connections also set
# default_transaction_read_only. Only turn this on if you mean it — and prefer
# a read-only database user over trusting this flag.
DB_ALLOW_WRITES=false

# Per-statement timeout, milliseconds.
DB_STATEMENT_TIMEOUT_MS=300000

# For MORE than one database, copy connections.example.json to connections.json
# (gitignored) and list them there. DB_DEFAULT picks which one is used when the
# assistant doesn't name one.
#DB_CONNECTIONS_FILE=connections.json
#DB_DEFAULT=main


# ===========================================================================
# 3. SCRIPTS
# ===========================================================================
# Any .sh / .py in this folder becomes a tool the assistant can run.
# See scripts/README.md for the header format that describes them.
SCRIPTS_ENABLED=true
#SCRIPTS_DIR=scripts
SCRIPT_TIMEOUT=300


# ===========================================================================
# 4. SERVER
# ===========================================================================
APP_NAME=Work Assistant AI
PORT=8800

# Loopback by default, and that is the right default. The websocket is plain
# ws://, not wss://, so anything you type — including a password a script asks
# for — would cross your network unencrypted on 0.0.0.0. Only change this if
# you have put TLS in front of it.
HOST=127.0.0.1

OPEN_BROWSER=true

# Max tool calls the model may make per message, so a retry loop can't run away.
TOOL_BUDGET=8

# Extra instructions appended to the system prompt. Good place for house style,
# naming conventions, or "always use the reporting schema".
#SYSTEM_PROMPT_EXTRA=
